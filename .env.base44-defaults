# ClaimIQ — local defaults (placeholders only; real secrets in /run/base44/app.env)
# Endpoints below are non-secret URLs sourced from Config.docx.
# API keys are delivered securely by the Base44 platform and override the empty
# values here. Live AI mode auto-activates when AZURE_OPENAI_API_KEY is present.

DEMO_MODE=true

AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://dtai.cognitiveservices.azure.com/
AZURE_OPENAI_ENDPOINT=https://dtai-openai-resource.openai.azure.com
AZURE_SEARCH_ENDPOINT=https://dtai.search.windows.net

AZURE_OPENAI_CHAT_DEPLOYMENT=claimiq-chat
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=claimiq-embedding
AZURE_SEARCH_INDEX=claimiq-knowledge

# Keys — populated by /run/base44/app.env (Base44 secrets platform); left blank here.
AZURE_DOCUMENT_INTELLIGENCE_KEY=
AZURE_OPENAI_API_KEY=
AZURE_SEARCH_QUERY_KEY=
